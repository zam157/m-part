{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "paths": {
      "~/*": ["./client/*"],
      "#shared/*": ["./shared/*"]
    },
    "types": [
      "node",
      "vite/client",
      "vite-plugin-pwa/client",
      "chrome"
    ]
  },
  "include": [
    "./test/client/**/*.ts",
    "./test/client/**/*.tsx",
    "./client/**/*.ts",
    "./client/**/*.tsx",
    "./shared/**/*.ts",
    "./entrypoints/**/*.ts"
  ]
}
