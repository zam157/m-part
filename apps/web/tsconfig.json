{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "chrome"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "~/*": [
        "../../packages/player/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/music/src/vite-env.d.ts",
    "../../packages/player/src/*.d.ts"
  ]
}
