# Copy to .env.local and open the exact origin configured below.
DATABASE_URL=postgresql://mpart:mpart-local-dev@127.0.0.1:5433/mpart
BETTER_AUTH_URL=http://localhost:3411
BETTER_AUTH_SECRET=
# Password for the fixed username "admin" (12–128 characters).
MPART_ADMIN_PASSWORD=
# Only set this behind a trusted proxy that overwrites the named header.
ACCOUNT_CLIENT_IP_HEADER=
