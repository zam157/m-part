{
  "name": "m-part",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @m-part/web dev",
    "build": "pnpm --filter @m-part/web build",
    "build:all": "pnpm build && pnpm build:ext && pnpm build:rooms",
    "dev:ext": "pnpm --filter @m-part/extension dev",
    "build:ext": "pnpm --filter @m-part/extension build",
    "dev:rooms": "pnpm --filter @m-part/rooms dev",
    "dev:rooms:lan": "pnpm --filter @m-part/rooms dev:lan",
    "build:rooms": "pnpm --filter @m-part/rooms build",
    "dev:listen": "pnpm --filter @m-part/rooms dev:lab",
    "build:listen": "pnpm --filter @m-part/rooms build:lab",
    "build:listen-client": "pnpm --filter @m-part/rooms build:lab-client",
    "test": "vitest",
    "test:frontend": "vitest run --project player --project music",
    "test:listen": "vitest run --project listen-core --project rooms --project listen-lab",
    "test:backend": "pnpm --filter @m-part/web test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:frontend": "pnpm --filter @m-part/player --filter @m-part/music --filter @m-part/extension typecheck",
    "typecheck:backend": "pnpm --filter @m-part/web --filter @m-part/rooms typecheck",
    "typecheck:listen": "pnpm --filter @m-part/listen-core --filter @m-part/rooms typecheck",
    "preview": "pnpm --filter @m-part/web preview",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@unocss/eslint-config": "catalog:build",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "eslint-plugin-solid": "catalog:dev",
    "nano-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "vite": "catalog:build"
  }
}
